# Copy this file to secrets.yaml and fill in your values.
# DO NOT commit secrets.yaml to version control!

# OTA update password (ota_password in main.yaml)
display_ota: "YourOTAPassword"

# Password of the "Routine Controller Setup" access point used to configure Wi-Fi
wifi_ap_password: "AtLeast8Characters"

# Security PIN code for the alarm panel
security_pin_code: "1234"
